# Copy this file to .env (same folder as app.py) and fill in real values. NEVER commit .env.
# Gemini is optional: without a key, everything except AI review works.
#
# Keys from Google AI Studio now start with "AQ." (new auth keys); older keys start
# with "AIza". Both work - paste the whole key after the = sign, no quotes, no spaces.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=30

# Optional overrides
# STOCKSENSE_DB_PATH=data/stocksense.db
# STOCKSENSE_LOG_PATH=data/stocksense.log
# STOCKSENSE_MAX_UPLOAD_BYTES=2000000
# STOCKSENSE_LOG_LEVEL=INFO
